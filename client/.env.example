BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BACKEND_AUTH_SECRET=replace-with-another-random-secret-matching-server-env
BACKEND_URL=http://127.0.0.1:8000
BETTER_AUTH_DATABASE=auth.db
# Comma-separated Better Auth user IDs; new accounts are buyers by default.
ADMIN_USER_IDS=
SELLER_USER_IDS=
# Enable only in a local demo; publicly displays the example credentials.
NEXT_PUBLIC_DEMO_ACCOUNTS=false
