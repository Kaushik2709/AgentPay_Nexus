# Supply your own Razorpay TEST credentials. Never commit real secrets.
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_TEST_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_YOUR_WEBHOOK_SECRET

# Local SQLite: both URLs must point to the same database.
DATABASE_URL=sqlite+aiosqlite:///./agentpay.db
SYNC_DATABASE_URL=sqlite:///./agentpay.db
DEFAULT_MERCHANT_MARGIN_FLOOR=0.20
DEFAULT_MAX_TX_AMOUNT=25000.0
DEFAULT_DAILY_VELOCITY_CAP=50000.0
PRICE_DRIFT_TOLERANCE_PCT=3.0

# Match client/.env.local BACKEND_AUTH_SECRET. This stays server-side.
BACKEND_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
